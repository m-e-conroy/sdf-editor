{
  "name": "sdf-studio-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:start": "node mcp-server/dist/index.js",
    "mcp:build": "npm run --prefix mcp-server build",
    "mcp:test": "npm test --prefix mcp-server"
  },
  "dependencies": {
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
