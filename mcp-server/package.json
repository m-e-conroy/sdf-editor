{
  "name": "@sdf-studio/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server & Live Studio Bridge for SDF Studio 3D",
  "type": "module",
  "bin": {
    "sdf-mcp": "./dist/index.js"
  },
  "scripts": {
