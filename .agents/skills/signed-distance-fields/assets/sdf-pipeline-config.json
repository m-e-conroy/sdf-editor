{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Standard configuration presets for SDF raymarching, MSDF font atlases, Jump Flooding Algorithm (JFA), and mesh extraction pipelines.",
  "raymarchingPresets": {
    "mobileRealtime": {
      "maxSteps": 64,
      "maxDistance": 50.0,
      "surfaceEpsilon": 0.002,
      "normalMethod": "tetrahedron_4tap",
      "normalEpsilon": 0.001,
      "shadowSteps": 24,
      "aoSteps": 3,
      "overRelaxationOmega": 1.25
    },
    "desktopHighQuality": {
      "maxSteps": 128,
      "maxDistance": 100.0,
      "surfaceEpsilon": 0.0005,
      "normalMethod": "tetrahedron_4tap",
      "normalEpsilon": 0.0005,
      "shadowSteps": 64,
      "shadowSoftnessK": 12.0,
      "aoSteps": 5,
      "overRelaxationOmega": 1.35
    },
    "distortedFieldConservative": {
      "comment": "Use when applying opTwist, opCheapBend, non-uniform scale, or high-frequency displacement noise.",
      "maxSteps": 256,
      "maxDistance": 100.0,
      "surfaceEpsilon": 0.00025,
      "stepRelaxationLambda": 0.6,
      "overRelaxationOmega": 1.0
    }
  },
  "msdfFontAtlas": {
    "type": "msdf",
    "glyphSizePx": 48,
    "distanceRangePx": 4.0,
    "angleThresholdRadians": 3.0,
    "textureFiltering": "LINEAR",
    "shaderReconstruction": "median(r, g, b) - 0.5"
  },
  "jumpFloodingJFA": {
    "variant": "1+JFA+1",
    "neighborhoodKernel": "3x3_chebyshev",
    "rtsdfTemporalDecayAlpha": 0.85,
    "rtsdfFineRayThreshold": 0.08
  },
  "meshExtraction": {
    "smoothOrganic": {
      "algorithm": "gridhopping_marching_cubes",
      "resolution": 128,
      "isoLevel": 0.0,
      "complexity": "O(N^2 log N)"
    },
    "sharpCadCsg": {
      "algorithm": "dual_contouring_qef",
      "resolution": 128,
      "isoLevel": 0.0,
      "hermiteGradient": "tetrahedron_4tap",
      "qefRegularization": 0.01
    }
  }
}

