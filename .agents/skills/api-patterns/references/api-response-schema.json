{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JSend-Inspired API Response",
  "description": "Standardized wrapper for all API responses",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["success", "fail", "error"]
    },
    "data": {
      "type": ["object", "array", "null"],
      "description": "Payload for success or fail"
    },
    "message": {
      "type": "string",
      "description": "Human readable error message"
    },
    "code": {
      "type": "integer",
      "description": "Internal error code for debugging"
    },
    "meta": {
      "type": "object",
      "description": "Pagination, timestamps, etc."
    }
  },
  "required": ["status"]
}
