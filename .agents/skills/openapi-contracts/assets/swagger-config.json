{
  "openapi": "3.0.3",
  "info": {
    "title": "Antigravity API",
    "description": "Standardized API Contract for Agent Ecosystem",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000/v1", "description": "Local Development" }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
