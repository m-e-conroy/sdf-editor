{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BehaviorTree",
  "description": "Standard schema for game AI behavior trees",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "root": { "$ref": "#/definitions/node" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["Sequence", "Selector", "Task", "Decorator", "Parallel"]
        },
        "name": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        },
        "params": { "type": "object" }
      },
      "required": ["type"]
    }
  }
}
